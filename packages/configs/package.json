{
  "name": "@bpm2025-website/configs",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    "./typescript": "./src/typescript.json",
    "./lint": "./src/lint/index.ts",
    "./uno": "./src/uno.ts"
  },
  "scripts": {
    "lint": "eslint .",
